{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aonin",
  "version": "0.1.7",
  "identifier": "io.github.rosydaqbar.aonin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Highest-quality real-time audio over the local network",
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "14.2",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "windows-hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4NkQ2NDYzMkRDMEExMTUKUldRVm9jQXRZMlJ0NkpzM3JTbkF2am5TREFqSm95UWJSR3ZJNDFRUm44MFdWenRNRllvWWVOV2cK",
      "endpoints": [
        "https://github.com/rosydaqbar/aonin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
